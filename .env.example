# Shared secret between shop-service and the ingestion script (write auth).
# Change this to something random before deploying anywhere shared.
INTERNAL_TOKEN=dev-internal-token

# Used only by the ingestion script (services/shop-service/ingestion/seed_from_google_places.py)
# to call the Google Places API. Get one from https://console.cloud.google.com/
# with the "Places API (New)" enabled.
GOOGLE_MAPS_API_KEY=

# Where shop-service stores its SQLite file.
SHOP_DB_PATH=./data/shops.db

# How location-service reaches shop-service.
SHOP_SERVICE_URL=http://localhost:8001
